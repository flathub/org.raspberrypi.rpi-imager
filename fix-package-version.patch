--- a/src/cmake/GenerateVersion.cmake
+++ b/src/cmake/GenerateVersion.cmake
@@ -12,7 +12,7 @@
 
 if(GIT_EXECUTABLE)
     execute_process(
-        COMMAND "${GIT_EXECUTABLE}" describe --tags --always --dirty
+        COMMAND "${GIT_EXECUTABLE}" describe --tags --exact-match
         WORKING_DIRECTORY "${SOURCE_DIR}"
         OUTPUT_VARIABLE GIT_DESCRIBE
         OUTPUT_STRIP_TRAILING_WHITESPACE
@@ -23,6 +23,19 @@
         set(VERSION_STR "${GIT_DESCRIBE}")
     endif()
 endif()
+
+# Use the pinned release commit for AppStream metadata as well.
+execute_process(
+    COMMAND "${GIT_EXECUTABLE}" log -1 --format=%cs
+    WORKING_DIRECTORY "${SOURCE_DIR}"
+    OUTPUT_VARIABLE RELEASE_DATE
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    RESULT_VARIABLE DATE_RESULT
+)
+if(NOT GIT_RESULT EQUAL 0 OR NOT DATE_RESULT EQUAL 0 OR NOT RELEASE_DATE)
+    message(FATAL_ERROR "Packaging requires a tagged release with a commit date")
+endif()
+string(REGEX REPLACE "^v" "" RELEASE_VERSION "${VERSION_STR}")
 
 # Parse numeric version components (e.g. v2.0.0-rc4-60-geac7c2f0 → 2, 0, 0, 0)
 #
@@ -77,6 +90,8 @@
 set(CMAKE_CONTENT "\
 # Auto-generated by GenerateVersion.cmake — do not edit
 set(IMAGER_VERSION_STR \"${VERSION_STR}\")
+set(IMAGER_RELEASE_VERSION \"${RELEASE_VERSION}\")
+set(IMAGER_RELEASE_DATE \"${RELEASE_DATE}\")
 set(IMAGER_VERSION_MAJOR ${VERSION_MAJOR})
 set(IMAGER_VERSION_MINOR ${VERSION_MINOR})
 set(IMAGER_VERSION_PATCH ${VERSION_PATCH})
